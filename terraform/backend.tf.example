# Rename to backend.tf only after creating and securing the backend resources.
# Never guess bucket/table names, and do not share one state key between environments.
terraform {
  backend "s3" {
    bucket       = "REPLACE-WITH-STATE-BUCKET"
    key          = "aws-casepack/lab/terraform.tfstate"
    region       = "ap-northeast-1"
    encrypt      = true
    use_lockfile = true
  }
}
